# Model used by every agent (LiteLLM name, or a gemini-* name for native ADK).
CHIP_AGENT_MODEL=ollama_chat/gemma4
OLLAMA_API_BASE=http://localhost:11434
# Context window and output cap per model call. Lower OLLAMA_NUM_CTX if you run out of memory.
OLLAMA_NUM_CTX=32768
CHIP_AGENT_MAX_TOKENS=8192
# Seconds allowed per model call (CPU-only Ollama is slow; a GPU needs far less).
CHIP_AGENT_TIMEOUT=1800

# Optional per-agent override, e.g. a stronger model only for code rewriting:
# CHIP_AGENT_MODEL_TRANSFORM=ollama_chat/gemma4

# Where agents read/write kernels, HLS code and testbenches (default: ./workspace)
# CHIP_AGENT_WORKSPACE=C:/path/to/workspace

# C++ compiler for C-simulation. Default: g++/clang++ on PATH, else `python -m ziglang c++`.
# CXX=g++

# Optional external tools (leave unset if not installed)
# XILINX_HLS=C:/Xilinx/Vitis_HLS/2024.2       # enables ap_int.h + run_hls_synthesis
# AUTOSA_ROOT=/home/me/AutoSA                 # path as seen by AUTOSA_CMD_PREFIX
# AUTOSA_CMD_PREFIX=wsl                       # AutoSA is Linux-only; run it through WSL
# HARP_CMD=python /opt/harp/run.py --kernel {kernel} --out {output}
# PROMETHEUS_CMD=...
# LIFT_CMD=...
